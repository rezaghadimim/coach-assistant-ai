# Coach Assistant AI — Environment Configuration
# Copy this file to .env and fill in values as needed.
# .env is gitignored; never commit secrets.

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="Coach Assistant AI"
APP_VERSION="0.3.0"

# ─────────────────────────────────────────────────────────────────────────────
# Ollama — local LLM (primary provider, always active)
# ─────────────────────────────────────────────────────────────────────────────
# URL of the running Ollama instance.
# - Docker Compose (macOS/Windows): http://host.docker.internal:11434
# - Running the API directly on your machine: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120.0

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter — optional cloud provider
# Set OPENROUTER_API_KEY to enable the cloud model in Open WebUI.
# Leave it empty (or unset) to keep the system fully local.
# Get your key at: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model slugs exposed in Open WebUI when OPENROUTER_API_KEY is set.
# The first slug maps to coach-assistant-ai-cloud; others get derived virtual IDs.
# Browse available models at https://openrouter.ai/models
OPENROUTER_MODELS=openai/gpt-4o-mini,openai/gpt-oss-120b:free,openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120.0
# Optional: your site URL for OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
# Optional: app name sent in X-Title header
OPENROUTER_APP_NAME="Coach Assistant AI"

# ─────────────────────────────────────────────────────────────────────────────
# Generation parameters (apply to both providers)
# ─────────────────────────────────────────────────────────────────────────────
TEMPERATURE=0.7
MAX_TOKENS=1024

# ─────────────────────────────────────────────────────────────────────────────
# RAG
# ─────────────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_DOCS_DIR=docs/knowledge
# Keep <= ~300 when using the E5 embed backend (512 subword token model limit).
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MIN_SCORE=0.05
# Stage-1 candidate pool before reranking. Should be >= RAG_TOP_K.
RAG_RETRIEVE_K=25
# Cross-encoder reranker — requires: uv sync --group rag-rerank  (or pip install sentence-transformers)
# Falls back gracefully to bi-encoder order when the package is not installed.
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_BATCH_SIZE=16
RAG_RERANK_MAX_PASSAGE_CHARS=2000

# ─────────────────────────────────────────────────────────────────────────────
# Tool Router — embedding-based tool disambiguation
# ─────────────────────────────────────────────────────────────────────────────
# Master switch. Set to false to skip tool routing and rely on LLM tool calling only.
TOOL_ROUTER_ENABLED=true
# Backend: "embedding" | "token" | "auto"
# "auto" uses the embedding backend when the embed model probe succeeds; falls back to token.
TOOL_ROUTER_BACKEND=auto
# Ollama embedding model (must be pulled: ollama pull karuniaperjuangan/multilingual-e5-small)
OLLAMA_EMBED_MODEL=karuniaperjuangan/multilingual-e5-small
# Directory containing per-tool markdown docs and examples/routing.jsonl
TOOL_KNOWLEDGE_DIR=docs/tool-knowledge
# Minimum cosine similarity score to consider a match confident
TOOL_ROUTER_THRESHOLD=0.75
# Minimum gap between best and runner-up score
TOOL_ROUTER_MARGIN=0.08
# Prepend "query:" / "passage:" prefixes for multilingual-e5 models
TOOL_ROUTER_USE_E5_PREFIX=true

# ─────────────────────────────────────────────────────────────────────────────
# Memory / SQLite
# ─────────────────────────────────────────────────────────────────────────────
MEMORY_DB_PATH=data/coach_assistant.db
SUMMARY_TRIGGER_MESSAGES=20
