# Coach Assistant AI — Environment Configuration
# Copy this file to .env and fill in values as needed.
# .env is gitignored; never commit secrets.

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="Coach Assistant AI"
APP_VERSION="0.3.0"

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────
# Shared API key required on every API route, sent as `X-API-Key: <key>` or
# `Authorization: Bearer <key>`. Auth fails closed: with API_KEY empty and
# DEBUG unset, every request is rejected (401).
API_KEY=
# Development mode: allows running without an API key. Never enable in production.
DEBUG=false
# Only local media files under this directory may be ingested as `local_media`
# sources; paths outside it are rejected (prevents arbitrary local file reads).
MEDIA_ROOT=data/media

# ─────────────────────────────────────────────────────────────────────────────
# Ollama — local LLM (primary provider, always active)
# ─────────────────────────────────────────────────────────────────────────────
# URL of the running Ollama instance.
# - Docker Compose (macOS/Windows): http://host.docker.internal:11434
# - Running the API directly on your machine: http://localhost:11434
# - Second server hosting the LLM: http://second-server:11434
# This is independent of the embedding (RAG_EMBED_BASE_URL) and reranker
# (RAG_RERANK_BASE_URL) addresses below — each can point at a different host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120.0
# Overall per-request budget for /api/chat and non-streaming /v1/chat/completions.
# The request returns 504 when the combined LLM hops exceed it.
REQUEST_TIMEOUT_S=90.0
# Budget for the background session-summarization task (off the request path).
SUMMARY_TIMEOUT_S=90.0
# Context window for chat completions. Ollama's own default (2048-4096 depending
# on version) silently truncates the prompt from the top, dropping the system
# prompt and tool definitions once RAG context + client notes are injected.
# 8192 fits the full coach prompt for 8B-class models; raise if you add more context.
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded after a request ("30m", "1h", "-1" = forever).
# The 5-minute Ollama default forces a slow full reload after short idle periods.
OLLAMA_KEEP_ALIVE=30m

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter — optional cloud provider
# Set OPENROUTER_API_KEY to enable the cloud model in Open WebUI.
# Leave it empty (or unset) to keep the system fully local.
# Get your key at: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model slugs exposed in Open WebUI when OPENROUTER_API_KEY is set.
# The first slug maps to coach-assistant-ai-cloud; others get derived virtual IDs.
# Browse available models at https://openrouter.ai/models
OPENROUTER_MODELS=openai/gpt-4o-mini,openai/gpt-oss-120b:free,openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120.0
# Optional: your site URL for OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
# Optional: app name sent in X-Title header
OPENROUTER_APP_NAME="Coach Assistant AI"

# ─────────────────────────────────────────────────────────────────────────────
# Embedding provider — used for RAG + tool router semantic search
# RAG_EMBED_PROVIDER selects the client/protocol: ollama | openrouter | openai.
# RAG_EMBED_BASE_URL is an optional address override so embeddings can run on
# their own machine (e.g. a second server), independently of the LLM and
# reranker addresses above/below. Leave empty (default) to reuse each
# provider's own address: ollama -> OLLAMA_BASE_URL, openai -> OPENAI_BASE_URL,
# openrouter -> OPENROUTER_BASE_URL.
# ─────────────────────────────────────────────────────────────────────────────
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_BASE_URL=
RAG_EMBED_MODEL=karuniaperjuangan/multilingual-e5-small
# Example: run embeddings on a second server via TEI's OpenAI-compatible
# /v1/embeddings endpoint instead of local Ollama:
# RAG_EMBED_PROVIDER=openai
# RAG_EMBED_BASE_URL=http://second-server:8081/v1

# Direct OpenAI embeddings (when RAG_EMBED_PROVIDER=openai and RAG_EMBED_BASE_URL
# is left empty). OPENAI_API_KEY is only required against the real
# api.openai.com host — a self-hosted server needs no key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# Generation parameters
# Per-task temperatures give the model the right "creativity budget" for each
# purpose.  Keep tool/grounded at 0 to eliminate hallucination; only advice
# responses benefit from a non-zero temperature.
# ─────────────────────────────────────────────────────────────────────────────
TEMPERATURE_TOOL=0.0       # tool-calling loop, LLM router, profile extraction
TEMPERATURE_GROUNDED=0.0   # RAG-grounded answers, data reply formatting
TEMPERATURE_ADVICE=0.5     # open coaching advice (free-form prose)
# Legacy fallback: used when no per-task temperature is given. Defaults to 0.5.
TEMPERATURE=0.5
MAX_TOKENS=1024
TOP_P=0.9
REPEAT_PENALTY=1.1
MAX_TOKENS_CLASSIFY=64     # token budget for LLM router classify calls
MAX_TOKENS_FORMATTER=256   # token budget for response-formatter LLM rephrase (tables use deterministic path)

# ─────────────────────────────────────────────────────────────────────────────
# RAG
# ─────────────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_KNOWLEDGE_STARTER_DIR=data/knowledge/starter
RAG_KNOWLEDGE_PRIVATE_DIR=data/knowledge/private
# Optional: document your private knowledge repo URL for teammates (not read by the app)
PRIVATE_KNOWLEDGE_REPO=https://github.com/rezaghadimim/coach-knowledge.git
# Legacy aliases: RAG_KNOWLEDGE_TEMPLATES_DIR and RAG_DOCS_DIR map to RAG_KNOWLEDGE_STARTER_DIR
# Setup guide: docs/knowledge/SETUP_PRIVATE_REPO.md
# Keep <= ~300 when using the E5 embed backend (512 subword token model limit).
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=2
# Stage-1 candidate pool floor (bi-encoder / token cosine).  Kept low for recall.
RAG_MIN_SCORE=0.15
# Final floor after cross-encoder reranking (sigmoid 0–1).  Higher than RAG_MIN_SCORE
# so off-topic queries abstain when the reranker is active.
RAG_RERANK_MIN_SCORE=0.42
# backend: "embedding" | "token" | "auto"
RAG_BACKEND=auto
# On-disk cache for chunk embeddings (embedding backend only).
RAG_INDEX_CACHE_PATH=data/rag_index_cache.json
# Stage-1 candidate pool before reranking. Should be >= RAG_TOP_K.
RAG_RETRIEVE_K=30
# RAG stage-2 reranker.
# RAG_RERANK_PROVIDER=local (default) runs a cross-encoder in-process via
# fastembed (ONNX, no Ollama). Default model: BAAI/bge-reranker-base
# (~1 GB, downloaded on first use). Falls back to stage-1 order when
# fastembed is missing or the model fails to load.
RAG_RERANK_ENABLED=true
RAG_RERANK_PROVIDER=local
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_BATCH_SIZE=32
RAG_RERANK_MAX_PASSAGE_CHARS=2000
# Where fastembed caches the downloaded reranker model (~1 GB, local provider only).
RAG_RERANK_CACHE_DIR=data/rerank_cache
# RAG_RERANK_PROVIDER=tei calls a remote Hugging Face Text-Embeddings-Inference
# server's POST /rerank instead — use this to offload reranking to a second
# machine. TEI serves one fixed model per deployment, so RAG_RERANK_MODEL is
# informational only in this mode (not sent in the request).
# RAG_RERANK_PROVIDER=tei
# RAG_RERANK_BASE_URL=http://second-server:8080
# RAG_RERANK_TIMEOUT=30
# Merge embedding + token stage-1 lists via RRF before reranking.
RAG_HYBRID_RRF_ENABLED=true

# Embed provider/model/address: see RAG_EMBED_PROVIDER / RAG_EMBED_BASE_URL /
# RAG_EMBED_MODEL near OLLAMA/OPENROUTER above.
# Optional override for collection ingest only (leave unset to reuse RAG_EMBED_*):
# RAG_COLLECTION_EMBED_PROVIDER=openrouter
# RAG_COLLECTION_EMBED_MODEL=openai/text-embedding-3-small
RAG_COLLECTIONS_DIR=data/knowledge/collections
# Real (non-demo) collections — merged after the public dir on ingest. Lives in
# the private knowledge submodule so scraped/licensed transcripts stay out of the
# public repo. Absent until the submodule is initialized (then it's picked up).
RAG_COLLECTIONS_PRIVATE_DIR=data/knowledge/private/collections
# Two-phase coach retrieval (problem match + expert solutions)
RAG_TWO_PHASE_ENABLED=true
RAG_PROBLEM_TOP_K=3
RAG_EXPERT_TOP_K=6
RAG_MIN_COLLECTIONS=2
RAG_MAX_CHUNKS_PER_COLLECTION=2

# ─────────────────────────────────────────────────────────────────────────────
# Tool Router — embedding-based tool disambiguation
# ─────────────────────────────────────────────────────────────────────────────
# Master switch. Set to false to skip tool routing and rely on LLM tool calling only.
TOOL_ROUTER_ENABLED=true
# Backend: "embedding" | "token" | "auto"
# "auto" uses the embedding backend when the embed model probe succeeds; falls back to token.
TOOL_ROUTER_BACKEND=auto
# Uses RAG_EMBED_MODEL (must be pulled when provider=ollama: ollama pull karuniaperjuangan/multilingual-e5-small)
# Directory containing per-tool markdown docs and examples/routing.jsonl
TOOL_KNOWLEDGE_DIR=data/tool-knowledge
# Minimum cosine similarity score to consider a match confident
# Tuned to 0.65 against 307-example corpus: 95.77% on hard eval, precision 1.00.
TOOL_ROUTER_THRESHOLD=0.65
# Minimum gap between best and runner-up score
TOOL_ROUTER_MARGIN=0.08
# Prepend "query:" / "passage:" prefixes for multilingual-e5 models
TOOL_ROUTER_USE_E5_PREFIX=true
# Two-stage rerank: stage-1 embedding recall → stage-2 cross-encoder precision.
TOOL_ROUTER_RERANK_ENABLED=true
TOOL_ROUTER_RERANK_TOP_K=10
TOOL_ROUTER_EMBED_FLOOR=0.30
TOOL_ROUTER_RERANK_THRESHOLD=0.55
TOOL_ROUTER_RERANK_MARGIN=0.10
TOOL_ROUTER_RERANK_MODEL=BAAI/bge-reranker-base
# LLM router fallback when all fast-path layers defer on data requests.
TOOL_ROUTER_LLM_FALLBACK_ENABLED=true
# Deferral observability: top score >= this on a deferred query counts as a near-miss.
TOOL_ROUTER_NEAR_MISS_SCORE=0.25

# ─────────────────────────────────────────────────────────────────────────────
# Memory / SQLite
# ─────────────────────────────────────────────────────────────────────────────
MEMORY_DB_PATH=data/coach_assistant.db
SUMMARY_TRIGGER_MESSAGES=20

# ─────────────────────────────────────────────────────────────────────────────
# Response Formatter
# LLM rephrases fast-path data replies into natural coach-facing text.
# Verified with scripts/benchmark_response_formatter.py (PII preservation 100%).
# Set to false to skip the extra LLM call and use the deterministic template.
# ─────────────────────────────────────────────────────────────────────────────
RESPONSE_FORMATTER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# Every chat message gets a short 6-char correlation id (e.g. msg=ab12cd).
# Each pipeline step emits a readable single-line log so you can trace exactly
# which step failed, skipped, or produced a hallucination.
#
# Usage:
#   docker compose logs -f coach-api
#   docker compose logs coach-api | grep "msg=ab12cd"    # trace one message
#   LOG_LEVEL=DEBUG docker compose up                    # verbose step-by-step
#
# Outcome vocabulary in logs:
#   hit | miss | skip | block | ok | preview | error | fail | fallback | hallucination
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Defaults to false to keep client PII (message/reply text snippets) out of logs.
# Set to true only for local debugging — it traces the pipeline step-by-step per message.
LOG_STEP_PAYLOADS=false
# Optional: persist ERROR-level logs to a file (Docker Compose sets /app/logs/errors.log).
# After testing: cat logs/errors.log — empty file means no errors were recorded.
# LOG_ERROR_FILE=logs/errors.log
